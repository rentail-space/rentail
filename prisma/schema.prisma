
generator client {
  provider               = "prisma-client"
  output                 = "generated"
  previewFeatures        = ["postgresqlExtensions"]
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "foreignKeys"
  extensions   = [postgis]
}

model Chat {
  createdAt DateTime   @map("created_at") @default(now())
  id        String     @map("id")         @id @default(cuid(2))
  messages  Messages[]
  metadata  Json       @map("metadata")   @db.Json
  title     String?    @map("title")
  updatedAt DateTime   @map("updated_at") @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")

  @@map("chats")
}

model Messages {
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String   @map("chat_id")
  content   Json     @map("content")    @db.Json
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamp(3)
  id        String   @map("id")         @id @default(cuid(2))
  role      Role     @map("role")
  type      String   @map("type")

  @@map("messages")
}

model User {
  accounts      Account[]
  chats         Chat[]
  createdAt     DateTime  @map("created_at")     @default(now())
  email         String?   @map("email")
  emailVerified Boolean   @map("email_verified") @default(false)
  geocode       Json      @map("geocode")        @db.Json
  id            String    @map("id")             @id @default(cuid(2))
  image         String?   @map("image")
  ip            String?   @map("ip")
  isAnonymous   Boolean   @map("is_anonymous")   @default(false)
  metadata      Json      @map("metadata")       @db.Json
  name          String?   @map("name")
  sessions      Session[]
  updatedAt     DateTime  @map("updated_at")     @updatedAt
  workingMemory String    @map("working_memory") @db.Text

  @@map("users")
  @@unique([email])
}

model Waitlist {
  createdAt DateTime @map("created_at") @default(now())
  email     String   @map("email")      @id @default(cuid(2))

  @@map("waitlist")
}

model ShoppingCenter {
  address     String                    @map("address")
  city        String                    @map("city")
  country     String                    @map("country")
  createdAt   DateTime                  @map("created_at")  @default(now())
  description String                    @map("description")
  id          String                    @map("id")          @id @default(cuid(2))
  imageURLs   String[]                  @map("image_urls")
  name        String                    @map("name")
  state       String                    @map("state")
  updatedAt   DateTime                  @map("updated_at")  @updatedAt
  location    Unsupported("geography")? @map("location")
  spaces      ShoppingCenterSpace[]

  @@map("shopping_centers")
}

model ShoppingCenterSpace {
  centerId    String         @map("shopping_center_id")
  createdAt   DateTime       @map("created_at")         @default(now())
  details     String         @map("details")
  id          String         @map("id")                 @id @default(cuid(2))
  imageURLs   String[]       @map("image_urls")
  updatedAt   DateTime       @map("updated_at")         @updatedAt
  footTraffic Int            @map("foot_traffic")
  cost        Int            @map("cost")
  size        Int            @map("size")
  available   String         @map("available")
  name        String         @map("name")
  center      ShoppingCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@map("shopping_center_spaces")
}

enum Role {
  assistant
  system
  tool
  user
}

model Session {
  id        String                      @id
  expiresAt DateTime @map("expires_at")
  token     String   @map("token")
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String                                     @id @default(cuid(2))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @map("scope")
  password              String?   @map("password")
  createdAt             DateTime  @map("created_at")               @default(now())
  updatedAt             DateTime  @map("updated_at")               @updatedAt

  @@map("account")
}

model Verification {
  id         String                      @id
  identifier String   @map("identifier")
  value      String   @map("value")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @map("created_at") @default(now())
  updatedAt  DateTime @map("updated_at") @default(now()) @updatedAt

  @@map("verification")
}
