generator client {
  provider               = "prisma-client"
  output                 = "generated"
  previewFeatures        = ["postgresqlExtensions"]
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

model Chat {
  activeStreamId String?    @map("active_stream_id")
  createdAt      DateTime   @map("created_at")       @default(now())
  id             String     @map("id")               @id
  messages       Messages[]
  metadata       Json       @map("metadata")         @db.Json
  title          String?    @map("title")
  updatedAt      DateTime   @map("updated_at")       @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String     @map("user_id")

  @@map("chats")
}

model Messages {
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String   @map("chat_id")
  content   Json     @map("content")    @db.Json
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamp(3)
  id        String   @map("id")         @id
  role      Role     @map("role")
  type      String   @map("type")

  @@map("messages")
}

model Property {
  address        String          @map("address")
  city           String          @map("city")
  country        String          @map("country")
  createdAt      DateTime        @map("created_at")       @default(now())
  demographics   String?         @map("demographics")
  description    String          @map("description")
  id             String          @map("id")               @id
  imageURLs      String[]        @map("image_urls")
  latitude       Float           @map("latitude")
  logoURL        String?         @map("logo_url")
  longitude      Float           @map("longitude")
  name           String          @map("name")
  numberOfStores Int             @map("number_of_stores")
  phone          String?         @map("phone")
  spaces         PropertySpace[]
  squareFootage  Int             @map("square_footage")
  state          String          @map("state")
  updatedAt      DateTime        @map("updated_at")       @updatedAt
  website        String          @map("website")

  @@map("properties")
}

model PropertySpace {
  available  Boolean   @map("available")
  id         String    @map("id")          @id
  number     String    @map("number")
  type       SpaceType @map("type")
  size       Int       @map("size")
  floor      Int       @map("floor")
  imageURLs  String[]  @map("image_urls")
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String    @map("property_id")
  updatedAt  DateTime  @map("updated_at")  @updatedAt

  @@map("property_spaces")
}

model Session {
  id        String                      @id
  expiresAt DateTime @map("expires_at")
  token     String   @map("token")
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model User {
  chats            Chat[]
  cityStateCountry String?   @map("city_state_country")
  createdAt        DateTime  @map("created_at")         @default(now())
  email            String?   @map("email")
  emailVerified    Boolean   @map("email_verified")     @default(false)
  geocode          Json      @map("geocode")            @db.Json
  id               String    @map("id")                 @id
  image            String?   @map("image")
  ip               String?   @map("ip")
  isAnonymous      Boolean   @map("is_anonymous")       @default(false)
  isBot            Boolean   @map("is_bot")             @default(false)
  metadata         Json      @map("metadata")           @db.Json
  name             String?   @map("name")
  note             String?   @map("note")
  passwordHash     String?   @map("password_hash")
  referrer         String?   @map("referrer")
  sessions         Session[]
  updatedAt        DateTime  @map("updated_at")         @updatedAt
  userAgent        String?   @map("user_agent")
  workingMemory    String    @map("working_memory")     @db.Text

  @@unique([email])
  @@map("users")
}

model Verification {
  createdAt  DateTime @map("created_at") @default(now())
  expiresAt  DateTime @map("expires_at")
  id         String   @map("id")         @id
  identifier String   @map("identifier")
  updatedAt  DateTime @map("updated_at") @default(now()) @updatedAt
  value      String   @map("value")

  @@map("verification")
}

model Waitlist {
  createdAt DateTime @map("created_at") @default(now())
  email     String   @map("email")      @id @default(uuid(4))

  @@map("waitlist")
}

enum Role {
  assistant
  user
}

enum SpaceType {
  Cart
  Inline
  Storage
  Other
}
