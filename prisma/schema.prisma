generator client {
  provider               = "prisma-client"
  output                 = "generated"
  previewFeatures        = ["postgresqlExtensions"]
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

model ApiUsage {
  id        String                                                                     @id @default(cuid())
  service   String   @map("service") // "google-places", "google-geocoding", "serpapi"
  endpoint  String   @map("endpoint") // "nearby-search", "geocode", "photo", etc.
  month     String   @map("month") // "2026-01" for monthly aggregation
  count     Int      @map("count")                                                     @default(0)
  cost      Float    @map("cost")                                                      @default(0)
  createdAt DateTime @map("created_at")                                                @default(now())
  updatedAt DateTime @map("updated_at")                                                @updatedAt

  @@unique([service, endpoint, month])
  @@index([month])
  @@map("api_usage")
}


model BotVisit {
  accept    String?  @map("accept")
  botType   String   @map("bot_type")
  count     Int                         @default(0)
  date      DateTime                    @db.Date
  firstSeen DateTime @map("first_seen") @default(now())
  id        String                      @id @default(cuid())
  ip        String?  @map("ip")
  lastSeen  DateTime @map("last_seen")  @updatedAt
  path      String   @map("path")
  referer   String?  @map("referer")
  userAgent String   @map("user_agent") @db.Text

  @@unique([date, userAgent, path])
  @@index([date])
  @@index([botType])
  @@map("bot_visits")
}

model Cache {
  key       String   @map("key")        @id
  value     Json     @map("value")      @db.Json
  createdAt DateTime @map("created_at") @default(now())

  @@map("cache")
}

model Chat {
  activeStreamId String?    @map("active_stream_id")
  createdAt      DateTime   @map("created_at")       @default(now())
  id             String     @map("id")               @id
  messages       Messages[]
  metadata       Json       @map("metadata")         @db.Json
  title          String?    @map("title")
  updatedAt      DateTime   @map("updated_at")       @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String     @map("user_id")

  @@map("chats")
}

model City {
  // All cities across the US. Cities are related to one state, one county, and
  // one metro area. No two cities can have the same name in the same state.
  county            County         @relation(fields: [countyId], references: [id], onDelete: Cascade)
  countyId          String         @map("county_id")
  id                String                               @id
  metroArea         MetroArea      @relation(fields: [metroAreaId], references: [id], onDelete: Cascade)
  metroAreaId       String         @map("metro_area_id")
  name              String         @map("name")
  regionalNames     RegionalName[] @relation("city_regional_name")
  slug              String         @map("slug")
  state             State          @relation(fields: [stateAbbreviation], references: [abbreviation], onDelete: Cascade)
  stateAbbreviation String         @map("state")

  @@map("cities")
  @@unique([name,   stateAbbreviation])
  @@unique([slug])
}

model County {
  // All counties across the US. Counties are related to one state and one metro
  // area.  County may have multiple cities. For example, "Los Angeles County"
  // is related to the "Los Angeles" city and the "San Fernando Valley" region.
  cities            City[]
  id                String                       @id
  name              String         @map("name")
  regionalNames     RegionalName[] @relation("county_regional_name")
  slug              String         @map("slug")
  state             State          @relation(fields: [stateAbbreviation], references: [abbreviation], onDelete: Cascade)
  stateAbbreviation String         @map("state")

  @@map("counties")
  @@unique([name,   stateAbbreviation])
  @@unique([slug])
}

model FollowUp {
  createdAt DateTime @map("created_at") @default(now())
  id        String                      @id
  message   String   @map("message")
  subject   String   @map("name")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")

  @@map("follow_ups")
}

model Messages {
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String   @map("chat_id")
  content   Json     @map("content")    @db.Json
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamp(3)
  id        String   @map("id")         @id
  role      Role     @map("role")
  type      String   @map("type")

  @@map("messages")
}

model MetroArea {
  // All major metro areas across the US. Metro area belongs to one state and
  // have a descriptive name, eg "San Francisco-Oakland-San Jose".
  cities            City[]
  id                String                       @id
  name              String         @map("name")
  regionalNames     RegionalName[]
  slug              String         @map("slug")
  state             State          @relation(fields: [stateAbbreviation], references: [abbreviation], onDelete: Cascade)
  stateAbbreviation String         @map("state")

  @@map("metro_areas")
  @@unique([name,   stateAbbreviation])
  @@unique([slug])
}

model Property {
  address           String          @map("address")
  centerType        CenterType      @map("center_type")                                           @default(CommunityCenter)
  city              String          @map("city")
  createdAt         DateTime        @map("created_at")                                            @default(now())
  demographics      String?         @map("demographics")
  description       String          @map("description")
  googlePlaceID     String          @map("google_place_id")
  id                String          @map("id")                                                    @id
  imageURLs         String[]        @map("image_urls")
  latitude          Float           @map("latitude")
  logoURL           String?         @map("logo_url")
  longitude         Float           @map("longitude")
  name              String          @map("name")
  numberOfStores    Int?            @map("number_of_stores")
  openFrom          Int?            @map("open_from") // Hour:minute eg 930 is 9:30
  openUntil         Int?            @map("open_until") // Hour:minute eg 2100 is 21:00
  phone             String?         @map("phone")
  ranking           Int?            @map("rated") // Rating (1-5) * log(reviewCount) * tier (1-3)
  rating            Float?          @map("rating") // 1.0-5.0
  reviewCount       Int?            @map("review_count")
  spaces            PropertySpace[]
  squareFootage     Int?            @map("square_footage")
  state             State           @relation(fields: [stateAbbreviation], references: [abbreviation], onDelete: Cascade)
  stateAbbreviation String          @map("state")
  summary           String?         @map("summary")
  tier              Int             @map("tier")                                                  @default(1) // 1 - Value 2 - Average 3 - Upscale
  updatedAt         DateTime        @map("updated_at")                                            @updatedAt
  website           String          @map("website")

  @@map("properties")
}

model PropertySpace {
  available  Boolean   @map("available")
  number     String    @map("number") // Unique identifier for the space
  type       SpaceType @map("type")
  size       Int?      @map("size")
  floor      Int?      @map("floor")
  imageURLs  String[]  @map("image_urls")
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String    @map("property_id")
  updatedAt  DateTime  @map("updated_at")                                @updatedAt

  @@map("property_spaces")
  @@unique([propertyId, number])
}

model RegionalName {
  // Regional names are used to group cities together. For example, "San
  // Fernando Valley" is a regional name for the cities of San Fernando,
  // Pacoima, and Van Nuys. K-Town is a regional name for the cities of
  // Koreatown, Chinatown, and Little Tokyo.
  id                String                          @id
  metroArea         MetroArea @relation(fields: [metroAreaId], references: [id], onDelete: Cascade)
  metroAreaId       String    @map("metro_area_id")
  name              String    @map("name")
  relatedCities     City[]    @relation("city_regional_name")
  relatedCounties   County[]  @relation("county_regional_name")
  slug              String    @map("slug")
  state             State     @relation(fields: [stateAbbreviation], references: [abbreviation], onDelete: Cascade)
  stateAbbreviation String    @map("state")

  @@map("regional_names")
  @@unique([name, metroAreaId, stateAbbreviation])
  @@unique([slug])
}

model Session {
  id        String                      @id
  expiresAt DateTime @map("expires_at")
  token     String   @map("token")
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model State {
  abbreviation  String         @map("abbreviation") @id
  cities        City[]
  counties      County[]
  country       String         @map("country")
  lede          String         @map("lede")
  metroAreas    MetroArea[]
  name          String         @map("name")
  properties    Property[]
  regionalNames RegionalName[]

  @@map("states")
  @@unique([abbreviation, country])
}

model User {
  chats         Chat[]
  createdAt     DateTime   @map("created_at")     @default(now())
  email         String?    @map("email")
  emailVerified Boolean    @map("email_verified") @default(false)
  followUps     FollowUp[]
  geocode       Json       @map("geocode")        @db.Json
  id            String     @map("id")             @id
  image         String?    @map("image")
  ip            String?    @map("ip")
  isAdmin       Boolean    @map("is_admin")       @default(false)
  isAnonymous   Boolean    @map("is_anonymous")   @default(false)
  isBot         Boolean    @map("is_bot")         @default(false)
  isMCP         Boolean    @map("is_mcp")         @default(false)
  isMobile      Boolean    @map("is_mobile")      @default(false)
  lastAlertAt   DateTime?  @map("last_alert_at")
  metadata      Json       @map("metadata")       @db.Json
  name          String?    @map("name")
  note          String?    @map("note")
  passwordHash  String?    @map("password_hash")
  referrer      String?    @map("referrer")
  sessions      Session[]
  updatedAt     DateTime   @map("updated_at")     @updatedAt
  userAgent     String?    @map("user_agent")
  utm           Json?      @map("utm")            @db.Json
  viewport      Json?      @map("viewport")       @db.Json
  workingMemory String     @map("working_memory") @db.Text

  @@unique([email])
  @@map("users")
}

model Verification {
  createdAt  DateTime @map("created_at") @default(now())
  expiresAt  DateTime @map("expires_at")
  id         String   @map("id")         @id
  identifier String   @map("identifier")
  updatedAt  DateTime @map("updated_at") @default(now()) @updatedAt
  value      String   @map("value")

  @@map("verification")
}

model VisibilityRun {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now()) @map("created_at")
  platform  String            @map("platform")
  model     String            @map("model")
  checks    VisibilityCheck[]

  @@map("visibility_runs")
}

model VisibilityCheck {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now()) @map("created_at")
  runId      String        @map("run_id")
  run        VisibilityRun @relation(fields: [runId], references: [id])
  repetition Int           @map("repetition")
  query      String        @map("query")
  category   String        @map("category")
  response   String        @map("response")
  mentioned  Boolean       @map("mentioned")
  position   Int?          @map("position")
  citations  String[]      @map("citations")

  @@map("visibility_checks")
}

enum Role {
  assistant
  user
}

enum SpaceType {
  Cart
  Inline
  Storage
  Other
}

enum CenterType {
  RegionalMall
  CommunityCenter
  StripCenter
  OutletCenter
  LifestyleCenter
}
