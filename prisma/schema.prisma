
generator client {
  provider               = "prisma-client"
  output                 = "generated"
  previewFeatures        = ["postgresqlExtensions"]
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "foreignKeys"
  extensions   = [postgis]
}

model Chat {
  activeStreamId String?    @map("active_stream_id")
  createdAt      DateTime   @map("created_at")       @default(now())
  id             String     @map("id")               @id
  messages       Messages[]
  metadata       Json       @map("metadata")         @db.Json
  title          String?    @map("title")
  updatedAt      DateTime   @map("updated_at")       @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String     @map("user_id")

  @@map("chats")
}

model Messages {
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String   @map("chat_id")
  content   Json     @map("content")    @db.Json
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamp(3)
  id        String   @map("id")         @id
  role      Role     @map("role")
  type      String   @map("type")

  @@map("messages")
}

model User {
  accounts         Account[]
  chats            Chat[]
  cityStateCountry String?   @map("city_state_country")
  createdAt        DateTime  @map("created_at")         @default(now())
  email            String?   @map("email")
  emailVerified    Boolean   @map("email_verified")     @default(false)
  geocode          Json      @map("geocode")            @db.Json
  id               String    @map("id")                 @id
  image            String?   @map("image")
  ip               String?   @map("ip")
  isAnonymous      Boolean   @map("is_anonymous")       @default(false)
  isBot            Boolean   @map("is_bot")             @default(false)
  metadata         Json      @map("metadata")           @db.Json
  name             String?   @map("name")
  referrer         String?   @map("referrer")
  sessions         Session[]
  updatedAt        DateTime  @map("updated_at")         @updatedAt
  userAgent        String?   @map("user_agent")
  workingMemory    String    @map("working_memory")     @db.Text

  @@map("users")
  @@unique([email])
}

model Waitlist {
  createdAt DateTime @map("created_at") @default(now())
  email     String   @map("email")      @id @default(uuid(4))

  @@map("waitlist")
}

model Property {
  address     String          @map("address")
  city        String          @map("city")
  country     String          @map("country")
  createdAt   DateTime        @map("created_at")  @default(now())
  description String          @map("description")
  id          String          @map("id")          @id
  imageURLs   String[]        @map("image_urls")
  latitude    Float           @map("latitude")
  longitude   Float           @map("longitude")
  name        String          @map("name")
  slug        String          @map("slug")        @unique
  spaces      PropertySpace[]
  state       String          @map("state")
  updatedAt   DateTime        @map("updated_at")  @updatedAt
  website     String          @map("website")

  @@map("properties")
}

model PropertySpace {
  available   String   @map("available")
  cost        Int      @map("cost")
  createdAt   DateTime @map("created_at")   @default(now())
  details     String   @map("details")
  footTraffic Int      @map("foot_traffic")
  id          String   @map("id")           @id
  imageURLs   String[] @map("image_urls")
  name        String   @map("name")
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String   @map("property_id")
  size        Int      @map("size")
  updatedAt   DateTime @map("updated_at")   @updatedAt

  @@map("property_spaces")
}


model Session {
  id        String                      @id
  expiresAt DateTime @map("expires_at")
  token     String   @map("token")
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String                                     @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @map("scope")
  password              String?   @map("password")
  createdAt             DateTime  @map("created_at")               @default(now())
  updatedAt             DateTime  @map("updated_at")               @updatedAt

  @@map("account")
}

model Verification {
  id         String                      @id
  identifier String   @map("identifier")
  value      String   @map("value")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @map("created_at") @default(now())
  updatedAt  DateTime @map("updated_at") @default(now()) @updatedAt

  @@map("verification")
}

enum Role {
  assistant
  user
}
