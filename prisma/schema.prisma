generator client {
  provider      = "prisma-client"
  output        = "generated"

  engineType             = "client"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "foreignKeys"
}

model Chat {
  activeStreamId String?   @map("active_stream_id")
  createdAt      DateTime  @map("created_at")       @default(now())
  id             String    @map("id")               @id @default(cuid(2))
  messages       Message[]
  updatedAt      DateTime  @map("updated_at")       @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")
}

model Message {
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String   @map("chat_id")
  content   String?  @map("content")
  createdAt DateTime @map("created_at") @default(now())
  id        Int      @map("id")         @default(autoincrement()) @id
  isAborted Boolean  @map("is_aborted") @default(false)
  messageId String   @map("message_id") @unique @default(ulid()) // AI SDK message ID
  reasoning String?  @map("reasoning")
  role      Role     @map("role")
}

model User {
  chats     Chat[]
  createdAt DateTime @map("created_at") @default(now())
  id        String   @map("id")         @id @default(cuid(2))
  ip        String?  @map("ip")
  latitude  String?  @map("latitude")
  longitude String?  @map("longitude")
  updatedAt DateTime @map("updated_at") @updatedAt
}

model Waitlist {
  createdAt DateTime @map("created_at") @default(now())
  email     String   @map("email")      @id
}

enum Role {
  ASSISTANT
  USER
}
