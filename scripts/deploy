#!/usr/bin/env bash

set -eo pipefail

echo -e "\033[0;32m--- Step 1: Check (fmt, lint, secrets) ---\033[0m"
pnpm check

if [ "$1" = "--skip-tests" ]; then
  echo -e "\033[0;33m--- Step 2: Skipping tests ---\033[0m"
else
  echo -e "\033[0;32m--- Step 2: Generate Prisma client and push test DB ---\033[0m"
  pnpm prisma generate
  pnpm test:db:push

  echo -e "\033[0;32m--- Step 3: Run tests ---\033[0m"
  pnpm vp test
fi

echo -e "\033[0;32m--- Step 4: Update production database ---\033[0m"
node scripts/load-env.mjs .env.prod -- pnpm prisma db push

echo -e "\033[0;32m--- Step 5: Build and deploy to Vercel ---\033[0m"
pnpm exec vercel pull --yes --environment=production
pnpm exec vercel build --prod
pnpm exec vercel deploy --prebuilt --prod

echo -e "\033[0;34m--- Deployed to https://rentail.space ---\033[0m"
open https://rentail.space
