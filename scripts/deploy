#!/usr/bin/env bash

# Deploy the application to Coolify.
# Builds a Docker image, pushes to GHCR, then triggers a Coolify deployment.

set -eo pipefail

echo -e "\033[32m  Checking code is clean \u2026\033[0m"
pnpm exec vp fmt --check
pnpm exec vp lint
secretlint "**/*" --format stylish

echo -e "\033[32m  Generating React Router types \u2026\033[0m"
pnpm react-router typegen

echo -e "\033[32m  Checking types \u2026\033[0m"
pnpm tsc --noEmit --strict

echo -e "\033[32m  Installing Playwright \u2026\033[0m"
pnpm exec playwright install

echo -e "\033[32m  Running tests \u2026\033[0m"
NODE_OPTIONS="--max-old-space-size=3096" vp test run --testNamePattern="^(?:(?!visual regression).)*$"

echo -e "\033[32m  Updating database \u2026\033[0m"
doppler --config prd run -- pnpm prisma db push

echo -e "\033[32m  Building and pushing Docker image \u2026\033[0m"
echo "$(doppler secrets get GHCR_TOKEN --plain --config dev)" | docker login ghcr.io -u assaf --password-stdin
export PRD_DOPPLER_TOKEN=$(doppler secrets get PRD_DOPPLER_TOKEN --plain --config dev)
docker buildx build \
  --platform linux/amd64 \
  --secret id=doppler_token,env=PRD_DOPPLER_TOKEN \
  --build-arg DOPPLER_PROJECT=rentail \
  --build-arg DOPPLER_CONFIG=prd \
  -t ghcr.io/rentail-space/rentail:latest \
  --push \
  .

echo -e "\033[32m  Triggering Coolify deployment \u2026\033[0m"
curl -s -X GET \
  -H "Authorization: Bearer $(doppler secrets get COOLIFY_TOKEN --plain --config prd)" \
  "https://coolify.labnotes.org/api/v1/deploy?uuid=c12diz0deab7ctmllamdugyg&force=false"
echo

echo -e "\033[32m  Done!\033[0m"
