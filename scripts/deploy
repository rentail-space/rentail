#!/usr/bin/env bash

set -eo pipefail

IMAGE="ghcr.io/rentail-space/rentail:latest"
APP_UUID="c12diz0deab7ctmllamdugyg"

echo "--- Step 1: Check (fmt, lint, secrets) ---"
pnpm exec vp fmt --check
pnpm exec vp lint
secretlint "**/*" --format stylish

echo "--- Step 2: Generate types ---"
pnpm react-router typegen

echo "--- Step 3: Check types ---"
pnpm tsc --noEmit --strict

echo "--- Step 4: Install Playwright ---"
pnpm exec playwright install

echo "--- Step 5: Run tests ---"
NODE_OPTIONS="--max-old-space-size=3096" vp test run --testNamePattern="^(?:(?!visual regression).)*$"

echo "--- Step 5: Update database ---"
doppler --config prd run -- pnpm prisma db push

echo "--- All checks passed. Deploying ---"

COLIMA_WAS_RUNNING=true
if ! colima status &>/dev/null; then
  COLIMA_WAS_RUNNING=false
  echo "Starting colima..."
  colima start
fi
cleanup() {
  if [ "$COLIMA_WAS_RUNNING" = false ]; then
    echo "Stopping colima..."
    colima stop
  fi
}
trap cleanup EXIT

echo "Building and pushing Docker image..."
echo "$(doppler secrets get GHCR_TOKEN --plain --config dev)" | docker login ghcr.io -u assaf --password-stdin
export PRD_DOPPLER_TOKEN=$(doppler secrets get PRD_DOPPLER_TOKEN --plain --config dev)
docker buildx build \
  --platform linux/amd64 \
  --secret id=doppler_token,env=PRD_DOPPLER_TOKEN \
  --build-arg DOPPLER_PROJECT=rentail \
  --build-arg DOPPLER_CONFIG=prd \
  -t "$IMAGE" \
  --push \
  .

echo "Triggering Coolify deployment..."
TOKEN=$(jq -r '.instances[0].token' ~/.config/coolify/config.json)
curl -s -X POST "https://coolify.labnotes.org/api/v1/deploy?type=application&uuid=$APP_UUID" \
  -H "Authorization: Bearer $TOKEN" | jq

echo "Deployed to https://rentail.space"
open https://rentail.space
