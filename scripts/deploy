#!/usr/bin/env bash

set -eo pipefail

IMAGE="ghcr.io/rentail-space/rentail:latest"
APP_UUID="c12diz0deab7ctmllamdugyg"

echo -e "\033[0;32m--- Step 1: Check (fmt, lint, secrets) ---\033[0m"
pnpm check

if [ "$1" = "--skip-tests" ]; then
  echo -e "\033[0;33m--- Step 2: Skipping tests ---\033[0m"
else
  echo -e "\033[0;32m--- Step 2: Generate Prisma client and push dev DB ---\033[0m"
  pnpm prisma generate
  pnpm prisma db push

  echo -e "\033[0;32m--- Step 3: Run tests ---\033[0m"
  NODE_OPTIONS="--max-old-space-size=3096" vp test run

  echo -e "\033[0;32m--- Step 4: Update production database ---\033[0m"
  infisical --env prod run -- pnpm prisma db push
fi

COLIMA_WAS_RUNNING=true
if ! colima status &>/dev/null; then
  COLIMA_WAS_RUNNING=false
  echo "Starting colima..."
  colima start
fi
cleanup() {
  if [ "$COLIMA_WAS_RUNNING" = false ]; then
    echo "Stopping colima..."
    colima stop
  fi
}
trap cleanup EXIT

echo -e "\033[0;32m--- Step 5: Building and pushing Docker image ---\033[0m"
echo "$(infisical secrets get GHCR_TOKEN --env dev --plain)" | docker login ghcr.io -u assaf --password-stdin
infisical export --env prod --format=dotenv > .env
docker buildx build \
  --platform linux/amd64 \
  -t "$IMAGE" \
  --push \
  .
rm -f .env

echo -e "\033[0;32m--- Step 6: Deploying to Coolify ---\033[0m"
npx coolify-deploy \
  --image "$IMAGE" \
  --app-uuid "$APP_UUID" \
  --healthcheck-url "https://rentail.space/health" \
  --healthcheck-timeout 60 \
  --force

echo -e "\033[0;34m--- Deployed to https://rentail.space ---\033[0m"
open https://rentail.space
