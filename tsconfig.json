{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".react-router/types/**/*",
    "app/types/*.d.ts"
  ],
  "exclude": ["node_modules", "build", ".vercel"],
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "~/*": ["./app/*"],
      "~/test/*": ["./test/*"],
      "~/types/*": [".react-router/types/*"],
      "prisma": ["./prisma/generated"],
      "prisma/generated": ["./prisma/generated"]
    },
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vite/client", "@react-router/node"],
    "verbatimModuleSyntax": true
  }
}
