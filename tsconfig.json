{
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    ".react-router/types/**/*",
    "test/**/*.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "__screenshots__",
    ".claude",
    ".cursor",
    ".devtools",
    ".github",
    ".vscode",
    "node_modules",
    "prisma/generated",
    "prisma/backup.sql",
    "public"
  ],
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "~/*": ["./app/*"],
      "~/test/*": ["./test/*"],
      "prisma/generated": ["./prisma/generated/client"],
      "prisma/generated/models": ["./prisma/generated/models"],
      "+types/*": ["./.react-router/types/*"]
    },
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "@react-router/node"],
    "verbatimModuleSyntax": true
  }
}
