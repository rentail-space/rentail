{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/components/ui/*.tsx",
    "app/emails/sendEmails.server.tsx",
    "app/global.css",
    "scripts/*.ts",
    "test/helpers/serverWorker.ts"
  ],
  "project": ["app/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "!__screenshots__"],
  "ignoreDependencies": [
    "@secretlint/secretlint-rule-preset-recommend",
    "portless"
  ],
  "ignore": ["app/lib/scrape/*.ts"],
  "ignoreIssues": {
    "app/lib/api/schemas.ts": ["exports"],
    "app/lib/html/parseHTML.ts": ["exports"],
    "app/lib/relativeTime.ts": ["exports"],
    "app/lib/formatDate.ts": ["exports"]
  },
  "ignoreBinaries": ["infisical"]
}
