.vercel
/node_modules/
google-rentail.json

# React Router
.env
.env.test
.react-router/
*.swp
/build/

# Ignore test results
__screenshots__/*.diff.png
__screenshots__/*.new.png
__screenshots__/*.new.html
__screenshots__/*.html.diff

# Need to re-generate on the server
prisma/generated

