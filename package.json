{
  "name": "rentail",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "prisma generate && react-router build",
    "check": "pnpm run lint && pnpm run typecheck",
    "checkly": "pnpx checkly test --update-snapshots --record",
    "clean": "rm -rf .react-router build",
    "dev": "react-router dev",
    "format": "biome format --write",
    "lint": "secretlint **/* --format stylish && biome lint",
    "start": "react-router-serve ./build/server/index.js",
    "test": "pnpm run lint && NODE_ENV=test prisma db push && prisma generate && pnpm run typecheck && vitest run --reporter verbose",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.17",
