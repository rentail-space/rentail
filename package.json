    "@vitest/browser": "^3.2.4",
    "checkly": "^6.2.0",
    "daisyui": "^5.0.47",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.54.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.11",
