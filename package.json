    "@react-router/serve": "^7.6.2",
    "@sentry/react": "^9.30.0",
    "@sentry/vite-plugin": "^3.5.0",
    "ai": "^4.3.16",
    "chalk": "^5.4.1",
    "dotenv": "^16.5.0",
    "env-var": "^7.5.0",
    "isbot": "^5.1.28",
    "ollama-ai-provider": "^1.2.0",
    "react": "^19.1.0",
