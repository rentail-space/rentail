{
  "name": "rentail",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build --force",
    "build:prisma": "prisma generate",
    "check": "secretlint **/* --format stylish && vp check --fix && react-router typegen",
    "clean": "rm -rf node_modules/.vite .react-router build",
    "clone": "./scripts/clone",
    "dev": "infisical --env dev run -- portless run -- react-router dev",
    "devmcp": "npx @modelcontextprotocol/inspector@latest http://localhost:5173/api/mcp",
    "devai": "npx @ai-sdk/devtools",
    "deploy": "./scripts/deploy",
    "format": "vp fmt",
    "lint": "vp lint --fix",
    "start": "react-router-serve ./build/server/index.js",
    "test": "pnpm run check && rm -rf __screenshots__ && infisical --env test run -- pnpm vp test run",
    "test:db:push": "infisical --env test run -- pnpm prisma db push",
    "prod:db:push": "infisical --env prod run -- pnpm prisma db push",
    "upgrade": "./scripts/upgrade.sh"
  },
