    "@tailwindcss/typography": "^0.5.17",
    "@tailwindcss/vite": "^4.1.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/browser": "^3.2.4",
    "checkly": "^6.5.0",
    "daisyui": "^5.1.13",
    "msw": "^2.11.2",
    "playwright": "^1.55.0",
    "prisma": "^6.16.2",
