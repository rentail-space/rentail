    "@prisma/adapter-pg": "^6.16.2",
    "@prisma/client": "^6.16.2",
    "@react-email/components": "0.5.3",
    "@react-router/fs-routes": "^7.9.1",
    "@react-router/node": "^7.9.1",
    "@react-router/serve": "^7.9.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.4",
    "@sentry/react-router": "^10.12.0",
    "@supabase/ssr": "^0.7.0",
    "@tailwindcss/postcss": "^4.1.13",
    "ai": "^5.0.47",
    "dayjs": "^1.11.18",
    "env-var": "^7.5.0",
    "es-toolkit": "^1.39.10",
    "feed": "^5.1.0",
    "front-matter": "^4.0.2",
    "human-format": "^1.2.1",
    "ioredis": "^5.7.0",
    "looks-same": "^10.0.1",
    "luxon": "^3.7.2",
    "marked": "^16.3.0",
    "pnpm": "^10.17.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-ga4": "^2.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.1",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.2",
    "resend": "^6.1.0",
    "resumable-stream": "^2.2.4",
    "schema-dts": "^1.1.5",
    "secretlint": "^11.2.4",
    "showify": "^0.2.1",
    "sonner": "^2.0.7",
    "streamdown": "^1.3.0",
    "tsx": "^4.20.5",
    "ulid": "^3.0.1",
    "use-stick-to-bottom": "^1.1.1"
