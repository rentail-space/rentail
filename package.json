    "@react-router/node": "^7.7.1",
    "@react-router/serve": "^7.7.1",
    "@secretlint/secretlint-rule-preset-recommend": "^10.2.1",
    "@sentry/react": "^9.42.0",
    "@sentry/vite-plugin": "^4.0.1",
    "ai": "^4.3.19",
    "chalk": "^5.4.1",
    "env-var": "^7.5.0",
    "front-matter": "^4.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-ga4": "^2.1.0",
    "react-markdown": "^10.1.0",
