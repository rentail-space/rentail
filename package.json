{
  "name": "rentail",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "react-router build",
    "check": "npm run lint && npm run typecheck",
    "checkly": "npx checkly test --update-snapshots --record",
    "clean": "rm -rf .react-router build",
    "dev": "react-router dev",
    "format": "biome format --write",
    "lint": "biome lint",
    "start": "react-router-serve ./build/server/index.js",
    "test": "npm run lint && npm run typecheck && vitest run --reporter verbose",
    "typecheck": "react-router typegen && tsc"
  },
