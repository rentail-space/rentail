{
  "name": "rentail",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "prisma generate && react-router build --force",
    "check": "pnpm run lint && pnpm run typecheck",
    "checkly": "pnpx checkly test --update-snapshots --record",
    "clean": "rm -rf node_modules/.vite .react-router build",
    "dev": "react-router dev",
    "format": "biome format --write",
    "lint": "secretlint **/* --format stylish && biome lint",
    "start": "react-router-serve ./build/server/index.js",
    "test": "rm -rf node_modules/.vite && pnpm run lint && NODE_ENV=test prisma db push && prisma generate && pnpm run typecheck && vitest run --reporter verbose",
    "typecheck": "react-router typegen && tsc --noEmit --noErrorTruncation --pretty false --incremental false"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.23",
    "@ai-sdk/react": "^2.0.60",
    "@forge42/seo-tools": "^1.4.5",
    "@logtail/node": "^0.5.6",
    "@logtail/types": "^0.5.6",
    "@mastra/core": "^0.20.0",
    "@mastra/memory": "^0.15.5",
    "@mastra/pg": "^0.17.1",
    "@prisma/adapter-pg": "^6.16.3",
    "@prisma/client": "^6.16.3",
    "@react-email/components": "0.5.5",
    "@react-router/fs-routes": "^7.9.3",
    "@react-router/node": "^7.9.3",
    "@react-router/serve": "^7.9.3",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.4",
    "@sentry/react-router": "^10.17.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@vercel/react-router": "^1.2.3",
    "@vercel/speed-insights": "^1.2.0",
    "ai": "^5.0.60",
    "better-auth": "^1.3.26",
    "dayjs": "^1.11.18",
    "debug": "^4.4.3",
    "dotenv": "^17.2.3",
    "env-var": "^7.5.0",
    "es-toolkit": "^1.39.10",
    "feed": "^5.1.0",
    "front-matter": "^4.0.2",
    "human-format": "^1.2.1",
    "ioredis": "^5.8.0",
    "looks-same": "^10.0.1",
    "luxon": "^3.7.2",
    "markdown-it": "^14.1.0",
    "marked": "^16.3.0",
    "nuqs": "^2.7.0",
    "pdfmake": "^0.2.20",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-ga4": "^2.1.0",
    "react-router": "^7.9.3",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.2",
    "resend": "^6.1.2",
    "schema-dts": "^1.1.5",
    "secretlint": "^11.2.4",
    "sonner": "^2.0.7",
    "streamdown": "^1.3.0",
    "tsx": "^4.20.6",
    "ulid": "^3.0.1",
    "use-stick-to-bottom": "^1.1.1",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@playwright/test": "^1.55.1",
    "@react-router/dev": "^7.9.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/debug": "^4.1.12",
    "@types/luxon": "^3.7.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.6.2",
    "@types/pdfmake": "^0.2.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser": "^3.2.4",
    "checkly": "^6.7.0",
    "daisyui": "^5.1.27",
    "msw": "^2.11.3",
    "playwright": "^1.55.1",
    "prisma": "^6.16.3",
    "react-email": "4.2.12",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "why-is-node-running": "^3.2.2"
  },
  "overrides": {},
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "@tailwindcss/oxide",
      "@vercel/speed-insights",
      "esbuild",
      "msw",
      "prisma"
    ],
    "overrides": {
      "pdfmake@<0.3.0-beta.17": ">=0.3.0-beta.17"
    }
  },
  "packageManager": "pnpm@10.18.0"
}
