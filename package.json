{
  "name": "rentail",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "react-router build",
    "check": "npm run lint && npm run typecheck",
    "checkly": "npx checkly test --update-snapshots --record",
    "clean": "rm -rf .react-router build",
    "dev": "env NODE_ENV=test react-router dev",
    "format": "biome format --write",
    "lint": "biome lint",
    "start": "react-router-serve ./build/server/index.js",
    "test": "npm run lint && npm run typecheck && vitest run --reporter verbose",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.5",
    "@ai-sdk/react": "^2.0.19",
    "@forge42/seo-tools": "^1.4.5",
    "@logtail/node": "^0.5.5",
    "@react-router/fs-routes": "^7.8.1",
    "@react-router/node": "^7.8.1",
    "@react-router/serve": "^7.8.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.0.2",
    "@sentry/react": "^10.5.0",
    "@sentry/vite-plugin": "^4.1.1",
    "@tailwindcss/postcss": "^4.1.12",
    "ai": "^5.0.19",
    "chalk": "^5.6.0",
    "dayjs": "^1.11.13",
    "env-var": "^7.5.0",
    "es-toolkit": "^1.39.10",
    "front-matter": "^4.0.2",
    "luxon": "^3.7.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-ga4": "^2.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.8.1",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.2",
    "schema-dts": "^1.1.5",
    "secretlint": "^11.0.2",
    "showify": "^0.2.1",
    "tiny-invariant": "^1.3.3",
    "use-stick-to-bottom": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "^1.55.0",
    "@react-router/dev": "^7.8.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.12",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitest/browser": "^3.2.4",
    "checkly": "^6.4.0",
    "daisyui": "^5.0.50",
    "msw": "^2.10.5",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
