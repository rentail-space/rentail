{
	"permissions": {
		"allow": ["Bash(git add:*)"]
	},
	"enableAllProjectMcpServers": false,
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "pnpm exec vp fmt . --write"
					},
					{
						"type": "command",
						"command": "pnpm exec vp lint"
					}
				]
			}
		]
	},
	"outputStyle": "clearframe"
}
