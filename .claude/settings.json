{
  "permissions": {
    "allow": [
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm install:*)",
      "Bash(git add:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "outputStyle": "clearframe",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "biome format --fix"
          },
          {
            "type": "command",
            "command": "biome lint"
          }
        ]
      }
    ]
  }
}
