{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck:*)",
      "Bash(npm audit:*)",
      "Bash(git commit:*)",
      "Bash(npm run lint)",
      "Bash(npm run build:*)",
      "Bash(git add:*)",
      "Bash(npm run test:*)",
      "mcp__emails__search_emails",
      "mcp__emails__get_email_content",
      "Bash(npm install:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "outputStyle": "clearframe",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "biome format --fix"
          },
          {
            "type": "command",
            "command": "biome lint"
          }
        ]
      }
    ]
  }
}
